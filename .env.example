# Shared passcode required to unlock the dashboard.
# Use 6+ characters — the gate has no rate limiting in v1, so avoid a 4-digit PIN.
DASHBOARD_PASSCODE=

# Random secret used to sign the session cookie. Generate with: openssl rand -base64 32
SESSION_SECRET=

# Neon Postgres connection string. Auto-populated if you add the Neon
# integration via Vercel's Storage tab; otherwise set manually for local dev.
DATABASE_URL=

# OAuth 2.0 Client ID/Secret from a Google Cloud project with the Calendar,
# Gmail, and Tasks APIs enabled.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Must exactly match an Authorized redirect URI on that OAuth client, e.g.
# https://<your-vercel-domain>/api/oauth/google/callback
GOOGLE_REDIRECT_URI=

# Comma-separated Google Calendar IDs to show (find a non-primary calendar's
# ID under its Settings and sharing -> Integrate calendar).
GOOGLE_CALENDAR_IDS=primary

# API key from a separate Anthropic Console account (console.anthropic.com) —
# NOT the same as a Claude.ai/Pro subscription. Powers the nightly email
# triage (model: claude-haiku-4-5).
ANTHROPIC_API_KEY=

# Random secret that authorizes the nightly cron request. Generate with:
# openssl rand -base64 32
# Vercel automatically sends this as `Authorization: Bearer <value>` when it
# invokes the cron schedule in vercel.json.
CRON_SECRET=
